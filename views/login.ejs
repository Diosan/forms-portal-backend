<!-- views/login.ejs -->
<!DOCTYPE html>
<html>
  <head>
    <title>Login</title>
    <link rel="icon" href="https://swif.ttlawcourts.org/admin/public/fav.png" type="image/x-icon">
    <link rel="stylesheet" href="https://swif.ttlawcourts.org/admin/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://swif.ttlawcourts.org/admin/public/style.css">
  </head>
  <body>

    
    <section class="admin-main-section d-flex align-items-center justify-content-center vh-100">

        <section class="form-container container text-left">
            <div class="row" style="border:1px solid #eee">
                <div class="col-md-6 text-center" style="padding: 30px 30px 30px 30px; background-color: #0050B2; color: white;">
                    <div style="display:block; margin:0 auto 10px auto; 
                        background-color:#fff; width:60px; height:60px; 
                        padding:10px; border-radius:50%;  ">
                        <img
                        src="https://swif.ttlawcourts.org/admin/public/cap.jpg"
                        alt="TTPS"
                        style="max-width:40px;"text-left
                        />
                    </div>
                    <h3 style="font-weight:400">
                        <span><strong>TTPS</strong></span>
                    </h3>
                    <h4 style="font-weight:400">
                        Admin Console
                    </h4>
                    <div class="">
                        Welcome
                    </div>
                    
                </div>  
                <div class="col-md-6" style="padding: 40px;">
                    <form
                    action="https://swif.ttlawcourts.org/ttps/admin/login"
                    method="POST"
                    class="swf-form"
                    >
                        <div class="">
                            <label required="" class="">TTPS Email Address</label
                            ><input
                            name="username"
                            placeholder="Email"
                            class="px-2 py-2"
                            value=""
                            />
                        </div>
                        <div class="">
                            <label required="" class=""
                            >Password</label
                            ><input
                            type="password"
                            value=""
                            name="password"
                            placeholder="Password"
                            autocomplete="new-password"
                            class="px-2 py-2"
                            />
                        </div>
                        <div class="">
                            <button  class="mt-1 btn btn-primary">Login</button>
                        </div>
                    </form>
                </div>
            </div>

        </section>
    </section>

    <script src="https://swif.ttlawcourts.org/admin/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>


