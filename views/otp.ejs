<!-- views/login.ejs -->
<!DOCTYPE html>
<html>
  <head>
    <title>Login</title>
    <link rel="icon" href="/fav.png" type="image/x-icon">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style.css">
    <!-- Add any additional head content here -->
    <style type="text/css">
        #spinner-container {
            margin-right: 8px; /* Adjust spacing between spinner and input */
        }
        .lock-icon{display:block}
        #swf-spinner{display:none}
        #swf-otp{border:1px solid #eee; padding:0 0 0 7px}
        #otpInput:focus {
            outline: none;
            box-shadow: none;
            border-color: inherit; /* Reset to default or set a specific color */
        }
    </style>
  </head>
  <body>

    
    <section class="admin-main-section d-flex align-items-center justify-content-center vh-100">

        <section class="form-container container text-left">
            <div class="row" style="border:1px solid #eee">
                <div class="col-md-6 text-center" style="padding: 30px 30px 30px 30px; background-color: #0050B2; color: white;">
                    <div style="display:block; margin:0 auto 10px auto; 
                        background-color:#fff; width:60px; height:60px; 
                        padding:10px; border-radius:50%;  ">
                        <img
                        src="/cap.jpg"
                        alt="TTPS"
                        style="max-width:40px;"text-left
                        />
                    </div>
                    <h3 style="font-weight:400">
                        <span><strong>TTPS</strong></span>
                    </h3>
                    <h4 style="font-weight:400">
                        Admin Console
                    </h4>
                    <div class="">
                        Welcome
                    </div>
                    
                </div>  
                <div class="col-md-6" style="padding: 40px;">
                    <form
                    id="otpForm" 
                    class="swf-form"
                    >
                        
                        <div class="">

                            
                                <% if (message) { %>
                                    <p class="text-center" style="font-size:.8rem; line-height:1.2rem">
                                        <%= message %>
                                    </p>
                                <% } else { %>
                                    <p class="text-center" style="color:#ff0000; font-size:.8rem; line-height:1.2rem">
                                        <%= error %>
                                    </p>
                                <% } %>
                                <div id="spinner" style="display: none;">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="sr-only">Loading...</span>
                                    </div>
                                </div>
                  
                                <div class="d-flex  mb-2" id="swf-otp">
                                    <!--
                                        <div id="spinner-container" class="d-flex justify-content-center align-items-center" style="width: 40px; display: none;">
                                        <div class="spinner-border" role="status" style="width: 1rem; height: 1rem;">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div> -->
                                    <div id="spinner-container" class="d-flex justify-content-center align-items-center " style="width: 40px;">
                                        <i id="lock-icon" class="fas fa-lock" style="font-size: 1.5rem;"></i>
                                        <image style="width:20px;" src="/public/lock.svg" alt="lock"/>
                                        <div id="swf-spinner" class="spinner-border text-primary" role="status" style="width: 1rem; height: 1rem; display: none;">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                    <input
                                        id="otpInput"
                                        name="otpCode"
                                        placeholder="OTP CODE"
                                        class="form-control flex-grow-1 px-2 py-1 fs-4"
                                        maxlength="6"
                                        minlength="6"
                                        pattern="\d{6}"
                                        style="border:none; text-align:center; letter-spacing:3px"
                                    />
                                </div>
                                
                        </div>
                       
                        <div class="">
                            <button  class="mt-1 btn btn-primary">Confirm</button>
                        </div>
                    </form>
                </div>
            </div>

        </section>
    </section>






    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/public/axios.min.js"></script>
    <!--<script src="/public/all.min.css"></script>-->

   

    <% var jsToken; %>
    <% if (typeof token !== 'undefined' && token) { %>
        <% jsToken = token; %>
    <% } else { %>
        <% jsToken = null; %>
    <% } %>

    <script type="text/javascript">
        var token = "<%= jsToken %>";

        if (token) {
            console.log("The variable is present: " + token);
            localStorage.setItem('auth_token', token);
        } else {
            console.log("token is not present.");
        }
    </script>

    <script type="text/javascript">
        document.getElementById('otpForm').addEventListener('submit', function(event) {
            event.preventDefault(); // Prevent the default form submission

            const lockIcon = document.getElementById('lock-icon');
            const spinner = document.querySelector('#spinner-container .spinner-border');
            
            // Show spinner, hide lock icon
            lockIcon.style.display = 'none';
            spinner.style.display = 'block';
    
            const otpCode = document.getElementsByName('otpCode')[0].value;
            const token = localStorage.getItem('auth_token'); // Retrieve the token from local storage

            
            axios({
                method: 'post',
                url: '/ttps/admin/mfa',
                data: {
                    otp: otpCode
                },
                headers: {
                    'Authorization': `Bearer ${token}`  // Set the token in the header
                }
            })
                .then(function(response) {
                    console.log(response.data);
                    // Hide spinner, show lock icon
                    spinner.style.display = 'none';
                    lockIcon.style.display = 'block';
                    if (response.data.token) {
                        localStorage.setItem('auth_token', response.data.token);
                    }
                    // Handle success, store token if returned
                    if (response.data.message != 'VERIFIED') {
                        console.log("Incorrect Code");
                        spinner.style.display = 'none';
                        lockIcon.style.display = 'block';
                    }
                    else{
                        spinner.style.display = 'none';
                        lockIcon.style.display = 'block';
                        console.log("Code Correct");
                        window.location.href = '/admin';
                    }
                  




                    // Redirect to the admin page
                    //
                })
                .catch(function(error) {
                    // Handle error
                    spinner.style.display = 'none';
                    lockIcon.style.display = 'block';

                    console.error('Error:', error);
                });
        });
    </script>


  </body>
</html>





