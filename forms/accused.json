{
    "schema": {
        "title": "Accused & Charges",
        "description": "Persons being charged and charges being laid",
        "type": "object",
        "required": [
          "firstName",
          "lastName"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "title": "First Name"
          },
          "middleName": {
            "type": "string",
            "title": "Middle Name"
          },
          "lastName": {
            "type": "string",
            "title": "Last Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "title": "Date of Birth"
          },
          "identificaionType": {
            "type": "string",
            "title": "Identification Type",
            "enum": [
              "National ID Card",
              "Passport",
              "Drivers Permit",
              "Other"
            ],
            "enumNames": [
              "National ID Card",
              "Passport",
              "Drivers Permit",
              "Other"
            ]
          },
          "identification": {
            "type": "string",
            "title": "Identification Number"
          },
          "gender": {
            "type": "string",
            "title": "Gender Identity",
            "enum": [
              "Man",
              "Woman",
              "Non-Binary",
              "Other"
            ],
            "enumNames": [
              "Man",
              "Woman",
              "Non-Binary",
              "Other"
            ]
          },
          "adulthood": {
            "type": "string",
            "title": "Adult or Child",
            "enum": [
              "Adult",
              "Child"
            ],
            "enumNames": [
              "Adult",
              "Child"
            ]
          },
          "previousCriminalRecord": {
              "type": "string",
              "title": "Previous Criminal Record ?",
              "enum": [
                "Unknown",
                "Yes",
                "No"
              ],
              "enumNames": [
                "Unknown",
                "Yes",
                "No"
              ]
          },
          "relatedMatters": {
              "type": "boolean",
              "title": "Any Related Matters ?"
          },
          "tntNational": {
              "type": "boolean",
              "title": "National of Trinidad and Tobago",
              "default": true
          },
          "tntResident": {
              "type": "boolean",
              "title": "Resident of Trinidad and Tobago",
              "default": true
          },
          "otherNational": {
              "type": "boolean",
              "title": "National of other country"
          },
          "otherResident": {
              "type": "boolean",
              "title": "Resident of other country"
          },
          "alias": {
            "type": "string",
            "title": "Alias"
          }

        }
    },
    "UI": {
        "address": {
            "ui:widget": "textarea"
        },
        "relatedMatters": {
          "ui:widget": "select"
        },
        "alias": {
          "ui:widget": "textarea"
        }
    }
}