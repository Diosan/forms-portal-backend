{
    "schema": {
        "title": "Accuseds & Charges",
        "description": "Persons being charged and charges being laid",
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "address",
          "dateOfBirth",
          "gender"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "title": "First Name"
          },
          "lastName": {
            "type": "string",
            "title": "Last Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "title": "Date of Birth"
          },
          "identificaionType": {
            "type": "string",
            "title": "Identificaion Type",
            "enum": [
              "National ID Card",
              "Passport",
              "Drivers Permit"
            ],
            "enumNames": [
              "National ID Card",
              "Passport",
              "Drivers Permit"
            ]
          },
          "identification": {
            "type": "string",
            "title": "Identification"
          },
          "gender": {
            "type": "string",
            "title": "Gender Identity",
            "enum": [
              "Male",
              "Female",
              "Non-Binary",
              "Other"
            ],
            "enumNames": [
              "Male",
              "Female",
              "Non-Binary",
              "Other"
            ]
          },
          "adulthood": {
            "type": "string",
            "title": "Adult or Child",
            "enum": [
              "Adult",
              "Child"
            ],
            "enumNames": [
              "Adult",
              "Child"
            ]
          },
          "previousCriminalRecord": {
              "type": "string",
              "title": "Previous Criminal Record ?",
              "enum": [
                "Unknown",
                "Yes",
                "No"
              ],
              "enumNames": [
                "Unknown",
                "Yes",
                "No"
              ]
          },
          "relatedMatters": {
              "type": "boolean",
              "title": "Any Related Matters ?"
          },
          "tntNational": {
              "type": "boolean",
              "title": "National of Trinidad and Tobago",
              "default": true
          },
          "tntResident": {
              "type": "boolean",
              "title": "Resident of Trinidad and Tobago",
              "default": true
          },
          "otherNational": {
              "type": "boolean",
              "title": "National of other country"
          },
          "otherResident": {
              "type": "boolean",
              "title": "Resident of other country"
          }

        }
    },
    "UI": {
        "address": {
            "ui:widget": "textarea"
        },
        "relatedMatters": {
          "ui:widget": "select"
      }
    }
}