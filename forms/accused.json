{
    "schema": {
        "title": "Accused & Charges",
        "description": "Persons being charged and charges being laid",
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "address",
          "dateOfBirth",
          "gender"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "title": "First Name"
          },
          "lastName": {
            "type": "string",
            "title": "Last Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "title": "Date of Address"
          },
          "gender": {
            "type": "string",
            "title": "Gender",
            "enum": [
              "Male",
              "Female"
            ],
            "enumNames": [
              "Male",
              "Female"
            ]
          },
          "adulthood": {
            "type": "string",
            "title": "Adult or Child",
            "enum": [
              "Adult",
              "Child"
            ],
            "enumNames": [
              "Adult",
              "Child"
            ]
          }

        }
    },
    "UI": {
        "address": {
            "ui:widget": "textarea"
        }
    }
}